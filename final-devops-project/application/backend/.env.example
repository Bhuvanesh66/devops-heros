# Copy to .env for a local run outside Docker (`uvicorn app.main:app --reload`).
# Leave DATABASE_URL unset to use a local SQLite file (taskflow.db).
# PostgreSQL example (placeholder credentials, local only):
# DATABASE_URL=postgresql+psycopg://taskflow:change-me@localhost:5432/taskflow
APP_ENV=development
LOG_LEVEL=INFO
# Only needed when the UI is served from a different origin (e.g. vite on :5173 without its proxy)
CORS_ORIGINS=
